# Copy to .env.local. Read on the server only (no NEXT_PUBLIC_ prefix), so the
# browser never talks to the API directly; see src/lib/api.ts.
API_URL=http://127.0.0.1:8000

# The request header that carries the visitor's address, set by the platform
# in front of this app: cf-connecting-ip (Cloudflare), x-real-ip (Nginx), or
# x-forwarded-for (Railway, Render, Fly). Leave unset with nothing in front;
# see src/lib/client-address.ts.
# CLIENT_IP_HEADER=x-forwarded-for
