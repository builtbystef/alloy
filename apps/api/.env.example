# Settings for apps/api. Copy to .env; every line here is also the default,
# so an empty .env works for local development.
#
# Each variable is a field of `Settings` in src/alloy_api/config.py, upper-cased
# with the ALLOY_ prefix. Durations take ISO 8601 ("P7D", "PT15M") or seconds.

# --- App ---------------------------------------------------------------------

ALLOY_APP_NAME="Alloy API"
# Level for the app's own loggers (the console mailer logs at INFO).
ALLOY_LOG_LEVEL="INFO"
# Set a Logfire write token to send requests, SQL, jobs, and logs to
# https://logfire.pydantic.dev. Unset: telemetry is off. See src/alloy_api/telemetry.py.
# ALLOY_LOGFIRE_TOKEN=""
# Shown in Logfire to tell deployments apart.
ALLOY_LOGFIRE_ENVIRONMENT="development"
# Origins allowed to call the API from a browser. The Next.js app proxies
# through its own origin, so this only matters for direct calls.
ALLOY_CORS_ORIGINS='["http://localhost:3000"]'
# Where links in emails (invitations, email verification, password resets) point.
ALLOY_FRONTEND_URL="http://localhost:3000"

# --- Database ----------------------------------------------------------------

# The PostgreSQL from compose.yaml (`vp run db:up`).
ALLOY_DATABASE_URL="postgresql+psycopg://alloy:alloy@localhost:5432/alloy"
# Log every SQL statement.
ALLOY_DATABASE_ECHO=false
# Connections each process keeps open, and how many more it may open under load.
ALLOY_DATABASE_POOL_SIZE=5
ALLOY_DATABASE_MAX_OVERFLOW=10
# PostgreSQL cancels any statement that runs longer than this.
ALLOY_DATABASE_STATEMENT_TIMEOUT="PT30S"

# --- Sessions and tokens -----------------------------------------------------

# How long a login stays valid.
ALLOY_SESSION_TTL="P30D"
# How long an invitation link works.
ALLOY_INVITE_TTL="P7D"
# How long an email verification link works.
ALLOY_VERIFICATION_TTL="P1D"
# How long a password reset link works.
ALLOY_PASSWORD_RESET_TTL="PT1H"
# How long the link that confirms a new email address works.
ALLOY_EMAIL_CHANGE_TTL="P1D"
# How long after asking to delete an account logging in can still bring it back.
# The purge job removes the account once this has passed.
ALLOY_ACCOUNT_DELETION_GRACE="P7D"

# --- Email -------------------------------------------------------------------

# "console" logs each message instead of sending it. See src/alloy_api/mail.
ALLOY_MAIL_PROVIDER="console"
ALLOY_MAIL_FROM="Alloy <no-reply@alloy.local>"

# --- Object storage ----------------------------------------------------------

# "s3" covers every S3-compatible service. See src/alloy_api/storage.
ALLOY_STORAGE_PROVIDER="s3"
ALLOY_STORAGE_BUCKET="alloy"
# The RustFS from compose.yaml. For AWS S3 itself set this to null.
ALLOY_STORAGE_ENDPOINT_URL="http://127.0.0.1:9000"
# Where the browser reaches storage, when that differs from the address above
# (the API inside Docker, the browser outside). Presigned URLs use it.
# ALLOY_STORAGE_PUBLIC_ENDPOINT_URL="http://localhost:9000"
ALLOY_STORAGE_REGION="us-east-1"
ALLOY_STORAGE_ACCESS_KEY="rustfsadmin"
ALLOY_STORAGE_SECRET_KEY="rustfsadmin"
# true: host/bucket/key URLs (RustFS, MinIO). false: bucket.host/key (AWS).
ALLOY_STORAGE_PATH_STYLE=true
# How long an upload or download URL stays valid.
ALLOY_STORAGE_URL_TTL="PT15M"

# --- Attachments and imports -------------------------------------------------

# Largest file a contact or company attachment may be (25 MB).
ALLOY_ATTACHMENT_MAX_BYTES=26214400
# Largest CSV an import may be (10 MB).
ALLOY_IMPORT_MAX_BYTES=10485760

# --- Background jobs ---------------------------------------------------------

# "redis": tasks go to Redis streams and `taskiq worker` runs them (see
# src/alloy_api/jobs). "memory": the API process runs them itself; no Redis,
# no worker, no scheduler. The tests use "memory".
ALLOY_JOBS_BROKER="redis"
# The Redis from compose.yaml.
ALLOY_REDIS_URL="redis://localhost:6379/0"
# How long a rate-limit or health-check call waits for Redis before failing.
ALLOY_REDIS_TIMEOUT="PT2S"

# --- Rate limits -------------------------------------------------------------

# Where the counters behind the login, signup, and emailed-link limits live.
# "redis": on ALLOY_REDIS_URL, shared by every API instance. "memory": in the
# process, for development without Redis; the tests use it. The limits
# themselves are constants in src/alloy_api/ratelimit.py.
ALLOY_RATE_LIMIT_STORE="redis"
# How long revoked logins, used invitations, and abandoned uploads stay before
# the hourly purge job removes them.
ALLOY_PURGE_AFTER="P7D"
# An import still queued or running after this is marked failed by the purge
# job, so a lost job does not show as running forever.
ALLOY_IMPORT_TIMEOUT="PT1H"
