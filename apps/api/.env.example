# Copy to .env. Variables are the Settings fields in src/alloy_api/config.py,
# upper-cased with the ALLOY_ prefix.
ALLOY_APP_NAME="Alloy API"
ALLOY_CORS_ORIGINS='["http://localhost:3000"]'
# The database from compose.yaml.
ALLOY_DATABASE_URL="postgresql+psycopg://alloy:alloy@localhost:5432/alloy"
ALLOY_DATABASE_ECHO=false
ALLOY_SESSION_TTL="P30D"
ALLOY_INVITE_TTL="P7D"
ALLOY_VERIFICATION_TTL="P1D"
ALLOY_LOG_LEVEL="INFO"
ALLOY_FRONTEND_URL="http://localhost:3000"
ALLOY_MAIL_PROVIDER="console"
ALLOY_MAIL_FROM="Alloy <no-reply@alloy.local>"
