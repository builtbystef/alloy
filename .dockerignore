# Build context for apps/api/Dockerfile and apps/web/Dockerfile (both build
# from the repository root). Everything the images need is copied by name in
# the Dockerfiles; this keeps installed dependencies, build output, secrets,
# and Git history out of the context.
.git
.github
.agents
.claude
.vscode
node_modules
.venv
.next
dist
out
coverage
.cache
.vite
.ruff_cache
.pytest_cache
__pycache__
*.tsbuildinfo
*.log
.env
.env.*
# Not needed inside the images
apps/api/tests
apps/api/compose.yaml
apps/*/Dockerfile
