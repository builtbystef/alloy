{
  "name": "alloy",
  "private": true,
  "license": "MIT",
  "author": "builtbystef",
  "type": "module",
  "scripts": {
    "check": "pnpm check:ts && pnpm check:py",
    "check:fix": "pnpm check:ts --fix && pnpm check:py:fix",
    "check:ts": "vp check",
    "check:py": "uv run ruff format --check . && uv run ruff check . && uv run ty check",
    "check:py:fix": "uv run ruff check --fix . && uv run ruff format . && uv run ty check",
    "test": "pnpm test:ts && pnpm test:py",
    "test:ts": "vp test",
    "test:py": "uv run pytest",
    "build": "vp run -r build",
    "ci": "pnpm check && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
